# NAV Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ---------- AI (S3 + S5) ----------
# Active Provider: 'ollama' (default, local) or 'openai' (paid API)
# S5: This is now the *preferred* provider, not the only one.
NAV_AI_PROVIDER=ollama

# S5 Routing Mode: 'auto' (router decides) or 'fixed' (use NAV_AI_PROVIDER only)
NAV_AI_ROUTING=auto

# Local Ollama Configuration
NAV_OLLAMA_URL=http://localhost:11434/api/chat
NAV_OLLAMA_MODEL=mistral

# OpenAI Configuration (Optional, for when you want paid frontier APIs)
NAV_OPENAI_API_KEY=
NAV_OPENAI_MODEL=gpt-4o-mini

# ---------- Voice (S4) ----------
# STT provider: 'whisper' (default, local via faster-whisper) or 'mock'
NAV_STT_PROVIDER=whisper
NAV_WHISPER_MODEL=base

# TTS provider: 'pyttsx3' (default, offline OS voices) or 'mock'
NAV_TTS_PROVIDER=pyttsx3

# Microphone
NAV_MICROPHONE_SAMPLE_RATE=16000

# Set to "1" to enable tests/test_voice_live.py (requires real mic + speakers + voice extras)
NAV_VOICE_LIVE=0
